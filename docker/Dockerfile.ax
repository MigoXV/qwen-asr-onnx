FROM registry.cn-hangzhou.aliyuncs.com/migo-dl/axengine:0.1.3-m4c-aarch64

ARG HTTP_PROXY
ARG HTTPS_PROXY
ARG NO_PROXY

ENV BSP_MSP_DIR=/opt/ax-sdk/msp_3.6.2/out \
    LD_LIBRARY_PATH=/opt/ax-sdk/msp_3.6.2/out/lib:/soc/lib:/opt/lib

WORKDIR /app

RUN export http_proxy="${HTTP_PROXY}" \
        https_proxy="${HTTPS_PROXY}" \
        HTTP_PROXY="${HTTP_PROXY}" \
        HTTPS_PROXY="${HTTPS_PROXY}" \
        NO_PROXY="${NO_PROXY}" \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        cmake \
        curl \
        git \
        unzip \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /opt/ax-sdk \
    && curl -fL --retry 5 \
        -o /tmp/msp_3.6.2.zip \
        https://github.com/ZHEQIUSHUI/assets/releases/download/ax_3.6.2/msp_3.6.2.zip \
    && unzip -q /tmp/msp_3.6.2.zip -d /opt/ax-sdk \
    && rm /tmp/msp_3.6.2.zip

COPY pyproject.toml poetry.lock README.md ./

RUN mkdir -p src/qwen_asr_onnx \
    && touch src/qwen_asr_onnx/__init__.py \
    && poetry install --only main --no-root

COPY . ./

RUN poetry install --only main \
    && AX_QWEN_ASR_BUILD_DIR=/tmp/ax-qwen-asr-build \
       AX_QWEN_ASR_BUILD_JOBS=4 \
       src/qwen_asr_onnx/ax_m4c/native/build_ax650.sh \
    && rm -rf /tmp/ax-qwen-asr-build

EXPOSE 50051

CMD ["poetry", "run", "qwen-asr", "serve"]
