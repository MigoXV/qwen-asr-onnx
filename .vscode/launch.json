    "version": "0.2.0",
    "configurations": [
        {
            "name": "grpc app",
            "type": "debugpy",
            "request": "launch",
            "module": "qwen_asr_onnx.commands.app",
            "args": [
                "serve",
                "--config",
                "examples/ax-m4c/grpc.yaml"
            ],
            "console": "integratedTerminal",
            "envFile": "${workspaceFolder}/.env"
        },
        {
            "name": "Python 调试程序: 当前文件",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "envFile": "${workspaceFolder}/.env"
        }
    ]
}
